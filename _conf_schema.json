{
    "openai": {
        "description": "OpenAI 兼容 API 配置",
        "type": "object",
        "items": {
            "api_key": {
                "description": "API 密钥",
                "type": "string"
            },
            "api_base": {
                "description": "API 基础地址",
                "hint": "例如: https://api.jiekou.ai/v3",
                "type": "string"
            },
            "model": {
                "description": "文生图模型名称",
                "hint": "例如: gpt-image-2",
                "type": "string"
            },
            "img_model": {
                "description": "图生图模型名称",
                "hint": "例如: gpt-image-2",
                "type": "string"
            },
            "default_size": {
                "description": "默认图片尺寸",
                "hint": "默认: 2048x2048",
                "type": "string"
            },
            "default_quality": {
                "description": "默认图片质量",
                "hint": "默认: medium",
                "type": "string"
            },
            "default_background": {
                "description": "默认背景",
                "hint": "transparent / opaque / auto，默认: auto",
                "type": "string"
            },
            "default_num": {
                "description": "默认生成图片数量",
                "hint": "默认: 1",
                "type": "int"
            },
            "timeout": {
                "description": "API 请求超时时间 (秒)",
                "hint": "默认: 120",
                "type": "int"
            }
        }
    },
    "presets": {
        "description": "预设 prompt 配置",
        "type": "object",
        "items": {
            "preset_list": {
                "description": "预设列表，每行一个: key=value",
                "hint": "例如:\nportrait=美丽的肖像照\nlandscape=风景照",
                "type": "text"
            }
        }
    }
}